    "url": "https://github.com/conor-ob/geo-resolve/issues"
  },
  "license": "MIT",
  "author": "Conor O'Brien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conor-ob/geo-resolve.git",
    "directory": "packages/geo-resolve"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
