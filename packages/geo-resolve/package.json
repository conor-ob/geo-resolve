{
  "name": "geo-resolve",
  "version": "0.1.0",
  "description": "Look up countries, subdivisions and territories by ISO 3166 code, name or alias, and convert between Alpha-2, Alpha-3 and numeric codes.",
  "keywords": [
    "alpha-2",
    "alpha-3",
    "alpha-4",
    "alpha2",
    "alpha3",
    "countries",
    "country",
    "country-code",
    "country-codes",
    "country-names",
    "fifa",
    "geo",
    "historic-countries",
    "ioc",
    "iso-3166",
    "iso-3166-1",
    "iso-3166-2",
    "iso-3166-3",
    "iso3166",
    "lookup",
    "normalize",
    "numeric",
    "province",
    "region",
    "resolve",
    "state",
    "subdivision",
    "subdivisions",
    "territories",
    "typescript"
  ],
  "homepage": "https://github.com/conor-ob/geo-resolve#readme",
  "bugs": {
    "url": "https://github.com/conor-ob/geo-resolve/issues"
  },
  "license": "MIT",
  "author": "Conor O'Brien",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conor-ob/geo-resolve.git",
    "directory": "packages/geo-resolve"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "geo-resolve:source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./data/countries": {
      "geo-resolve:source": "./src/data/countries.ts",
      "default": "./dist/data/countries.mjs"
    },
    "./data/historic-countries": {
      "geo-resolve:source": "./src/data/historic-countries.ts",
      "default": "./dist/data/historic-countries.mjs"
    },
    "./data/subdivisions": {
      "geo-resolve:source": "./src/data/subdivisions.ts",
      "default": "./dist/data/subdivisions.mjs"
    },
    "./data/territories": {
      "geo-resolve:source": "./src/data/territories.ts",
      "default": "./dist/data/territories.mjs"
    },
    "./data/subdivisions/*": {
      "geo-resolve:source": "./src/data/subdivisions/*.ts",
      "default": "./dist/data/subdivisions/*.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./data/countries": "./dist/data/countries.mjs",
      "./data/historic-countries": "./dist/data/historic-countries.mjs",
      "./data/subdivisions": "./dist/data/subdivisions.mjs",
      "./data/territories": "./dist/data/territories.mjs",
      "./data/subdivisions/*": "./dist/data/subdivisions/*.mjs"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "typecheck": "tsc -p .",
    "test": "vp test run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
